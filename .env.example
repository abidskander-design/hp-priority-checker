# Copy this file to .env and add your key from https://build.nvidia.com
# Optional: without a key, predictions still work but the LLM explanation is skipped.
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: LLM used for explanations (default: fast, ~3 s per change).
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# For reasoning mode (slower, 15-50 s, follows the verdict more closely):
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_THINKING=1
